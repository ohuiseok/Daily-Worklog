NOTION_TOKEN=ntn_xxx
NOTION_DATABASE_ID=your_database_or_data_source_id
NOTION_SOURCE=Desktop

WORKLOG_PROJECT_NAME=Desktop Worklog
WORKLOG_ROOT_PATHS=%USERPROFILE%/Desktop
WORKLOG_TIMEZONE=Asia/Seoul

WORKLOG_MAX_FILE_SIZE_KB=1024
WORKLOG_MAX_SCANNED_FILES=20000
WORKLOG_MAX_SCAN_SECONDS=180
WORKLOG_MAX_ANALYSIS_FILES=10000
WORKLOG_HASH_FILE_CONTENT=false
WORKLOG_TEXT_PREVIEW_LINES=40
WORKLOG_TABLE_PREVIEW_ROWS=10
WORKLOG_EXCLUDE_DIRS=.git;.worklog;.pytest_cache;node_modules;.venv;venv;dist;build;.next;.cache;.gradle;.gradle-home;__pycache__;$RECYCLE.BIN;Cache;Cache_Data;Code Cache;GPUCache;DawnCache;ShaderCache;GrShaderCache;Service Worker;IndexedDB;Local Storage;Session Storage;blob_storage
WORKLOG_EXCLUDE_EXTENSIONS=.lnk;.png;.jpg;.jpeg;.gif;.webp;.ico;.zip;.7z;.rar;.exe;.msi;.dll;.jar;.bin;.pem;.key;.p12;.pfx;.crt;.cer;.tmp;.log;.lock;.spec
WORKLOG_EXCLUDE_NAME_PATTERNS=~$*;스크린샷*;Screenshot*;test_workspace

WORKLOG_GIT_AUTO_AUTHOR=true
WORKLOG_GIT_AUTHOR_EMAILS=
WORKLOG_GIT_AUTHOR_NAMES=

WORKLOG_UPLOAD_RAW_CONTENT=true
WORKLOG_UPLOAD_FILE_ATTACHMENTS=false
WORKLOG_UPLOAD_RELATIVE_PATHS_ONLY=true
WORKLOG_MASK_SENSITIVE_FILE_NAMES=true
